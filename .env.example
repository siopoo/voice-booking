# 复制为 .env 后填写；不要提交真实密钥。
PAWPILOT_LLM_API_KEY=your-api-key
PAWPILOT_LLM_MODEL=deepseek-chat
PAWPILOT_LLM_BASE_URL=https://api.deepseek.com
PAWPILOT_LLM_TIMEOUT=45
PAWPILOT_LLM_MAX_RETRIES=3

# 服务与存储（Docker Compose 会覆盖为容器内路径）
PAWPILOT_HOST=127.0.0.1
PAWPILOT_PORT=8000
PAWPILOT_DATABASE_PATH=appointments.db
PAWPILOT_BUSINESS_CONFIG_PATH=config/business.json
PAWPILOT_LOG_LEVEL=INFO

# 可选：后端语音转文字（需 OpenAI 兼容的 /audio/transcriptions 接口）
PAWPILOT_STT_API_KEY=your-stt-api-key
PAWPILOT_STT_MODEL=whisper-1
PAWPILOT_STT_BASE_URL=https://api.openai.com/v1

# Browser audio transcription. Use "sensevoice" for local inference or "api"
# for the OpenAI-compatible STT settings above.
PAWPILOT_STT_PROVIDER=sensevoice
PAWPILOT_SENSEVOICE_MODEL=iic/SenseVoiceSmall
PAWPILOT_SENSEVOICE_HUB=ms
PAWPILOT_SENSEVOICE_DEVICE=auto
PAWPILOT_SENSEVOICE_LANGUAGE=zh

# 可选：LangSmith 调试与追踪
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=pawpilot-booking-agent
